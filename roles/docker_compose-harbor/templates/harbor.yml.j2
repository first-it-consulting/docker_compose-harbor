# Harbor configuration - generated by ansible/docker-hosts/docker_compose-harbor role.
# Internal-only deployment for {{ harbor_hostname }} (no TLS, NFS-backed data).
# Format mirrors the official Harbor 2.10.x harbor.yml.tmpl (make/harbor.yml.tmpl).

# Configuration file of Harbor
hostname: {{ harbor_hostname }}

# http related config
http:
  # port for http; no https is configured (internal-only deployment)
  port: {{ harbor_http_port }}

# The initial password of Harbor admin (admin UI login)
harbor_admin_password: "{{ harbor_password }}"

# Harbor DB configuration (managed internally by the compose stack)
database:
  password: "{{ harbor_password }}"
  max_idle_conns: 100
  max_open_conns: 900

# The default data volume (all persistent state lives on the NFS mount)
data_volume: {{ harbor_data_volume }}

# Use external storage (NFS) for registry blobs.
storage_service:
  filesystem:
    root_directory: {{ harbor_data_volume }}/registry

# Trivy vulnerability scanner (disabled downloads in air-gapped internal use)
trivy:
  ignore_unfixed: false

# Job service configuration
jobservice:
  max_job_workers: 10
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1 #days

# Notification configuration
notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

# Log configurations
log:
  level: info
  local:
    rotate_count: 50
    rotate_size: 200M
    location: {{ harbor_data_volume }}/log

# This attribute is for migrator to detect the version of the .cfg file, DO NOT MODIFY!
_version: 2.10.0
